# Production Environment Variables Template
# Copy this file to .env on the production server and update with actual values

# Docker Image Configuration
IMAGE_NAME=ilyassanida/albaraka-banking
IMAGE_VERSION=latest

# Database Configuration
POSTGRES_DB=albaraka_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# Keycloak Configuration
KEYCLOAK_DB=keycloak_db
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
KEYCLOAK_HOSTNAME=165.232.122.222
KEYCLOAK_CLIENT_ID=albaraka-app
KEYCLOAK_CLIENT_SECRET=CHANGE_THIS_SECRET

# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_SECURE_SECRET_KEY_AT_LEAST_512_BITS_FOR_HS512_ALGORITHM
JWT_EXPIRATION=86400000

# Hibernate Configuration
HIBERNATE_DDL_AUTO=update

# Google Vertex AI Gemini Configuration
GEMINI_PROJECT_ID=albaraka-banking
GEMINI_LOCATION=us-central1
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7

# Spring Profiles
SPRING_PROFILES_ACTIVE=prod

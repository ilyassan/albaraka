# Database Configuration (already configured in docker-compose.yml)
# POSTGRES_DB=albaraka_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password

# JWT Configuration
# APP_JWT_SECRET=your-secret-key-here
# APP_JWT_EXPIRATION=86400000

# Google Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_PROJECT_ID=albaraka-banking
GEMINI_LOCATION=us-central1
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7

# OAuth2 Keycloak Configuration (already configured in docker-compose.yml)
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin123

              "raw": "{{baseUrl}}/oauth2/authorization/keycloak",
              "host": ["{{baseUrl}}"],
              "path": ["oauth2", "authorization", "keycloak"]
            },
            "description": "This will redirect to Keycloak login page. Use browser for this flow."
          }
        },
        {
          "name": "OAuth Success - Get User Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/oauth/user-info",
              "host": ["{{baseUrl}}"],
              "path": ["oauth", "user-info"]
            },
            "description": "After OAuth login via browser, this endpoint returns user info. Requires active OAuth session (cookie)."
          }
        },
        {
          "name": "Get Access Token (Password Grant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('oauthAccessToken', jsonData.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "albaraka-app"
                },
                {
                  "key": "client_secret",
                  "value": "KAxAb4XRfo41lzcyCBVUhboYyUrPDfvS"
                },
                {
                  "key": "username",
                  "value": "testuser@albaraka.com"
                },
                {
                  "key": "password",
                  "value": "Password123!"
                },
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "url": {
              "raw": "http://localhost:8081/realms/albaraka/protocol/openid-connect/token",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["realms", "albaraka", "protocol", "openid-connect", "token"]
            },
            "description": "Direct token request using password grant (for testing)"
          }
        }
      ]
    },

    {
      "name": "5. Admin - Transaction Management",
      "item": [
        {
          "name": "Get Pending Transactions (Agent)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/transactions/pending",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "transactions", "pending"]
            }
          }
        },
        {
          "name": "Approve Transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/transactions/{{transactionId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "transactions", "{{transactionId}}", "approve"]
            }
          }
        },
        {
          "name": "Reject Transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/transactions/{{transactionId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "transactions", "{{transactionId}}", "reject"]
            }
          }
        },
        {
          "name": "Approve Transaction - Already Approved",
          "request": {
            "method": "POST",
            "header": [

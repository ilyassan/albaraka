{
  "info": {
    "name": "ALBARAKA Banking API",
    "description": "Complete API collection for ALBARAKA Banking Application with JWT and OAuth 2.0 authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "clientUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "agentUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminUserId",
      "value": "",
      "type": "string"
